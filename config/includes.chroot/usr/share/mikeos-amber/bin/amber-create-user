#!/usr/bin/env python3
"""Mike OS: makes the first person's own account, then turns the "amber" account into Guest.

Run by the Create Your Account window through pkexec. It only works ONCE, from the amber account,
before the first account exists - after that it refuses, so it can't be used to make more admins.
Reads JSON on stdin: {"fullname", "username", "password", "admin": bool, "autologin": bool}
"""
import glob
import grp
import json
import os
import pwd
import re
import shutil
import subprocess
import sys

DONE = "/var/lib/mikeos-amber/account-setup-done"
GUEST = "amber"
LOGIN_CHECK = "/usr/share/mikeos-amber/bin/amber-login-check"
GROUPS = ["audio", "video", "plugdev", "netdev", "bluetooth", "lpadmin", "scanner", "users", "input",
          "render", "gpio", "i2c", "spi", "dialout", "cdrom", "floppy"]
SYSTEM_NAMES = {"root", "guest", "admin", "amber", "daemon", "bin", "sys", "sync", "games", "man", "lp", "mail",
                "news", "uucp", "proxy", "backup", "list", "irc", "nobody", "sddm", "lightdm", "messagebus",
                "systemd", "pulse", "avahi", "colord", "saned", "polkitd", "rtkit", "sudo"}


def fail(msg):
    print("ERROR:" + msg)
    sys.exit(1)


def run(*cmd, data=None):
    r = subprocess.run(cmd, input=data, capture_output=True, text=True)
    if r.returncode:
        fail("%s didn't work: %s" % (cmd[0], (r.stderr or r.stdout).strip()))


def main():
    if os.geteuid() != 0:
        fail("This has to run as administrator.")
    if os.path.exists(DONE):
        fail("Your account has already been set up.")
    caller = os.environ.get("PKEXEC_UID")
    if caller is not None:
        try:
            if pwd.getpwuid(int(caller)).pw_name != GUEST:
                fail("Only the Amber account can do the first-time setup.")
        except (KeyError, ValueError):
            fail("Couldn't tell who is asking.")
    try:
        d = json.loads(sys.stdin.read())
    except ValueError:
        fail("Bad request.")

    full = " ".join(str(d.get("fullname", "")).split())[:60]
    user = str(d.get("username", "")).strip()
    pw = str(d.get("password", ""))
    if not full or any(c in full for c in ":,=\\\n"):
        fail("Type your name (no : or , in it).")
    if not re.fullmatch(r"[a-z][a-z0-9-]{1,30}", user):
        fail("User names are 2 to 31 lowercase letters, numbers or dashes, starting with a letter.")
    if user in SYSTEM_NAMES:
        fail("That user name is taken by the system. Try another one.")
    try:
        pwd.getpwnam(user)
        fail("There's already an account called %s." % user)
    except KeyError:
        pass
    if len(pw) < 4 or "\n" in pw:
        fail("Your password needs at least 4 characters.")

    groups = [g for g in GROUPS if _group(g)]
    if d.get("admin"):
        groups.append("sudo")
    run("useradd", "-m", "-s", "/bin/bash", "-c", full, "-G", ",".join(groups), user)
    run("chpasswd", data="%s:%s\n" % (user, pw))

    # same picture as the Amber account
    icon_dir = "/var/lib/AccountsService"
    src = os.path.join(icon_dir, "icons", GUEST)
    if os.path.exists(src):
        shutil.copy(src, os.path.join(icon_dir, "icons", user))
        os.makedirs(os.path.join(icon_dir, "users"), exist_ok=True)
        with open(os.path.join(icon_dir, "users", user), "w") as f:
            f.write("[User]\nIcon=%s\nSystemAccount=false\n" % os.path.join(icon_dir, "icons", user))

    # Amber becomes Guest: anyone can sign in with no password, but it can't change the system
    try:
        pwd.getpwnam(GUEST)
        run("chfn", "-f", "Guest", GUEST)
        run("passwd", "-d", GUEST)
        if _group("sudo") and GUEST in grp.getgrnam("sudo").gr_mem:
            run("gpasswd", "-d", GUEST, "sudo")
    except KeyError:
        pass
    # running from a USB stick: the live system lets Amber do admin things with no password - not any more
    for f in ["/etc/sudoers.d/live"] + glob.glob("/etc/polkit-1/localauthority/*/*live-config*") + \
            glob.glob("/etc/polkit-1/rules.d/*live-config*"):
        try:
            os.remove(f)
        except OSError:
            pass

    # sign-in screen: start straight into the new account, or show the list of accounts
    for path in glob.glob("/etc/sddm.conf.d/*.conf") + ["/etc/sddm.conf"]:
        try:
            text = open(path).read()
        except OSError:
            continue
        if "[Autologin]" not in text:
            continue
        if d.get("autologin"):
            text = re.sub(r"(?m)^User=.*$", "User=" + user, text) if re.search(r"(?m)^User=", text) \
                else text.replace("[Autologin]", "[Autologin]\nUser=" + user, 1)
        else:
            text = re.sub(r"(?m)^User=.*\n?", "", text)
        with open(path, "w") as f:
            f.write(text)

    os.makedirs(os.path.dirname(DONE), exist_ok=True)
    with open(DONE, "w") as f:
        f.write(user + "\n")
    # remembered so auto sign-in can come back if the other accounts are removed;
    # amber-login-check turns it off at startup whenever there's more than one personal account
    remember = os.path.join(os.path.dirname(DONE), "autologin-user")
    if d.get("autologin"):
        with open(remember, "w") as f:
            f.write(user + "\n")
    elif os.path.exists(remember):
        os.remove(remember)
    if os.path.exists(LOGIN_CHECK):
        subprocess.run([LOGIN_CHECK])
    print("OK:" + user)


def _group(name):
    try:
        grp.getgrnam(name)
        return True
    except KeyError:
        return False


if __name__ == "__main__":
    main()
