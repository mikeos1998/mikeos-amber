# Mike OS: Amber boot screen: logo, name and a progress bar on orange.
Window.SetBackgroundTopColor(1.0, 0.70, 0.16);
Window.SetBackgroundBottomColor(0.71, 0.29, 0.0);

cx = Window.GetX() + Window.GetWidth() / 2;
cy = Window.GetY() + Window.GetHeight() / 2;

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetPosition(cx - logo.image.GetWidth() / 2, cy - logo.image.GetHeight() / 2 - 60, 10);

title.image = Image("title.png");
title.sprite = Sprite(title.image);
title.sprite.SetPosition(cx - title.image.GetWidth() / 2, cy + 80, 10);

track.image = Image("track.png");
track.sprite = Sprite(track.image);
track.x = cx - track.image.GetWidth() / 2;
track.y = cy + 150;
track.sprite.SetPosition(track.x, track.y, 10);

bar.image = Image("bar.png");
bar.sprite = Sprite();
bar.sprite.SetPosition(track.x + 1, track.y + 1, 11);

fun progress_callback(duration, progress) {
    w = Math.Int((track.image.GetWidth() - 2) * progress);
    if (w < 1) w = 1;
    bar.sprite.SetImage(bar.image.Scale(w, track.image.GetHeight() - 2));
}
Plymouth.SetBootProgressFunction(progress_callback);

# ---- password prompt (only used if the disk is encrypted)
box.image = Image("box.png");
lock.image = Image("lock.png");
bullet.image = Image("bullet.png");
box.sprite = Sprite(box.image);
box.x = cx - box.image.GetWidth() / 2;
box.y = cy + 190;
box.sprite.SetPosition(box.x, box.y, 20);
box.sprite.SetOpacity(0);
lock.sprite = Sprite(lock.image);
lock.sprite.SetPosition(box.x - lock.image.GetWidth() - 10, box.y + 8, 20);
lock.sprite.SetOpacity(0);
bullets = [];

fun display_password_callback(prompt, count) {
    box.sprite.SetOpacity(1);
    lock.sprite.SetOpacity(1);
    for (i = 0; bullets[i] || i < count; i++) {
        if (!bullets[i]) {
            bullets[i] = Sprite(bullet.image);
            bullets[i].SetPosition(box.x + 12 + i * (bullet.image.GetWidth() + 4), box.y + 13, 21);
        }
        if (i < count) bullets[i].SetOpacity(1);
        else bullets[i].SetOpacity(0);
    }
}

fun display_normal_callback() {
    box.sprite.SetOpacity(0);
    lock.sprite.SetOpacity(0);
    for (i = 0; bullets[i]; i++) bullets[i].SetOpacity(0);
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
