#!/bin/sh
set -e

# --- default desktop settings for every new user (Amber theme, colors, splash)
C=/etc/skel/.config
mkdir -p "$C"

sed -e '/^\[KDE\]$/a LookAndFeelPackage=org.mikeos.amber\nwidgetStyle=Windows' \
    /usr/share/color-schemes/Amber.colors > "$C/kdeglobals"
printf '\n[Icons]\nTheme=oxygen\n' >> "$C/kdeglobals"

cat > "$C/kwinrc" <<'CFG'
[org.kde.kdecoration2]
ButtonsOnLeft=M
ButtonsOnRight=IAX
library=org.kde.kwin.aurorae
theme=__aurorae__svg__Amber
CFG

cat > "$C/plasmarc" <<'CFG'
[Theme]
name=Amber
CFG

cat > "$C/ksplashrc" <<'CFG'
[KSplash]
Engine=KSplashQML
Theme=org.mikeos.amber
CFG

cat > "$C/kscreenlockerrc" <<'CFG'
[Daemon]
Autolock=false
LockOnResume=false
CFG

# --- browser: make every new tab the Amber search page
F=/usr/share/mikeos-amber/firefox
if [ -d /usr/lib/firefox-esr ]; then
    mkdir -p /usr/lib/firefox-esr/defaults/pref
    cat "$F/autoconfig.js" > /usr/lib/firefox-esr/defaults/pref/autoconfig.js
    cat "$F/mikeos-amber.cfg" > /usr/lib/firefox-esr/mikeos-amber.cfg
fi

# --- swap every stock system sound for an 8-bit one
S=/usr/share/sounds/mikeos-amber
for f in /usr/share/sounds/Oxygen-*.ogg; do
    [ -e "$f" ] || continue
    case "$(basename "$f")" in
        *Log-In*)   src=startup ;;
        *Log-Out*)  src=shutdown ;;
        *Error*|*Critical*|*Cant*|*Problem*|*Lost*|*Negative*) src=error ;;
        *Warning*)  src=warning ;;
        *Question*) src=question ;;
        *Trash*)    src=trash ;;
        *Window*|*List*|*Move*) src=click ;;
        *)          src=notify ;;
    esac
    cp "$S/$src.ogg" "$f"
done
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -f /usr/share/icons/hicolor || true
fi
